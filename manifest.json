{
  "manifest_version": 3,
  "name": "MediaPlus - 网页媒体抓取与下载",
  "version": "1.0.0",
  "description": "扫描并下载网页中的图片、视频、音频、文本与资源包；支持屏幕/窗口/标签页录制与桌面标注、HLS 合并、批量下载与收集篮管理。",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "sidePanel",
    "downloads",
    "webRequest",
    "webNavigation",
    "debugger",
    "alarms",
    "tabCapture",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "MediaPlus - 网页媒体抓取与下载",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "js/content.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "js/webrtc-main.js",
        "js/webrtc-bridge.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
