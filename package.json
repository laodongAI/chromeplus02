{
  "name": "chromeplus02",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome MV3 扩展（渐进式从 JS 迁移到 TypeScript + Vue3）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build && node build/scripts/postbuild.cjs",
    "lint": "eslint --ext .ts,.vue src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "vitest": "^1.0.0",
    "@types/chrome": "^0.0.246",
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "prettier": "^3.0.0",
    "playwright": "^1.45.0"
  }
}
