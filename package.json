{
  "name": "chromeplus02",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome MV3 扩展（渐进式从 JS 迁移到 TypeScript + Vue3）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -p tsconfig.json --noEmit && vite build && vite build -c vite.config.content.ts && vite build -c vite.config.webrtc-main.ts && vite build -c vite.config.webrtc-bridge.ts && node build/scripts/postbuild.cjs",
    "lint": "eslint --ext .ts,.vue src",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.246",
    "@types/jszip": "^3.4.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "5.9.3",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "vue-tsc": "^3.3.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}