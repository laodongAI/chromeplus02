{
  "name": "chromeplus02",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome MV3 扩展（渐进式从 JS 迁移到 TypeScript + Vue3）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build && vite build -c vite.config.content.ts && node build/scripts/postbuild.cjs",
    "lint": "eslint --ext .ts,.vue src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/jszip": "^3.4.0",
    "jszip": "^3.10.1",
    "vue": "^3.4.0",
    "soundtouchjs": "^0.1.31",
    "openai": "^4.47.0",
    "lamejs": "^1.2.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.246",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.0.0",
    "playwright": "^1.45.0",
    "prettier": "^3.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "@types/lamejs": "^1.2.2"
  }
}